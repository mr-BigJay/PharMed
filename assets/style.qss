QWidget {
    background-color: #071426;
    color: #F8FAFC;
    font-family: Vazirmatn;
    font-size: 14px;
}

QLabel {
    color: #F8FAFC;
    background: transparent;
}

QLineEdit,
QComboBox {
    background-color: #0D2038;
    border: 1px solid #1E3A5F;
    border-radius: 12px;
    padding: 12px;
    color: white;
    min-height: 24px;
}

QLineEdit:focus,
QComboBox:focus {
    border: 2px solid #2DD4BF;
}

QPushButton {
    background-color: #2DD4BF;
    border: none;
    border-radius: 12px;
    color: white;
    font-weight: bold;
    min-height: 48px;
}

QPushButton:hover {
    background-color: #14B8A6;
}

QPushButton:pressed {
    background-color: #0F766E;
}
#statCard {
    background:#0D2038;
    border:1px solid #1E3A5F;
    border-radius:18px;

    min-height:80px;
    max-height:100px;
}

#actionCard {
    background:#0D2038;
    border:1px solid #2DD4BF;
    border-radius:18px;

    min-height:45px;
    max-height:55px;
}

#actionCard:hover {
    background:#102845;
}
#pageTitle{
    font-size:34px;
    font-weight:700;
    color:#FFFFFF;
    margin-top:20px;
}

#pageSubtitle{
    font-size:15px;
    color:#CBD5E1;
    margin-bottom:15px;
}
#welcomeCard {
    background:#0D2038;
    border:1px solid #1E3A5F;
    border-radius:18px;
    padding:20px;
}

#welcomeTitle {
    font-size:18px;
    font-weight:700;
    color:white;
}

#welcomeLocation {
    font-size:16px;
    color:#2DD4BF;
    margin-top:10px;
}


#usersCountLabel{
    color:#22d3ee;
    font-size:11px;
    font-weight:600;
}

#welcomeInfo{
    color:#cbd5e1;
    font-size:12px;
    font-weight:600;
}

#loginPage {
    background: #FFFFFF;
}

#loginFormPanel {
    background: #FFFFFF;
    border: none;
}

#loginHeroPanel {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0 #EAF4FF,
        stop:0.45 #7CB8FF,
        stop:1 #147BFF
    );
    border: none;
}

#loginTitle {
    color: #0B2F66;
    font-size: 38px;
    font-weight: 1000;
}

#loginSubtitle {
    color: #0B2F66;
    font-size: 17px;
    font-weight: 900;
}

#loginDescription {
    color: #6B7A90;
    font-size: 13px;
    font-weight: 700;
}

#loginInput {
    background: #FFFFFF;
    border: 1px solid #DFE7F3;
    border-radius: 14px;
    color: #172033;
    min-height: 44px;
    padding: 10px 14px;
}

#loginInput:focus {
    border: 1px solid #147BFF;
}

#loginPrimaryButton {
    background: #147BFF;
    border: none;
    border-radius: 14px;
    color: #FFFFFF;
    font-weight: 900;
    min-height: 48px;
}

#loginPrimaryButton:hover {
    background: #0E6CE0;
}

#loginPrimaryButton:pressed {
    background: #0757B8;
}

#loginSecondaryButton {
    background: #FFFFFF;
    border: 1px solid #147BFF;
    border-radius: 14px;
    color: #147BFF;
    font-weight: 900;
    min-height: 48px;
}

#loginSecondaryButton:hover {
    background: #EAF4FF;
}

#loginFooter {
    color: #6B7A90;
    font-size: 11px;
    font-weight: 700;
}

#loginHeroTitle {
    color: #FFFFFF;
    font-size: 42px;
    font-weight: 1000;
}

#loginHeroSubtitle {
    color: rgba(255, 255, 255, 0.92);
    font-size: 16px;
    font-weight: 800;
}

#loginHeroIcon {
    color: #FFFFFF;
    font-size: 52px;
    min-width: 72px;
    min-height: 72px;
    qproperty-alignment: AlignCenter;
}

#loginHeroTagline {
    color: #FFFFFF;
    font-size: 22px;
    font-weight: 900;
    line-height: 1.5;
}