QWidget {
    background-color: #071426;
    color: #F8FAFC;
    font-family: Vazirmatn;
    font-size: 14px;
}

QLabel {
    color: #F8FAFC;
    background: transparent;
}

QLineEdit,
QComboBox {
    background-color: #0D2038;
    border: 1px solid #1E3A5F;
    border-radius: 12px;
    padding: 12px;
    color: white;
    min-height: 24px;
}

QLineEdit:focus,
QComboBox:focus {
    border: 2px solid #2DD4BF;
}

QPushButton {
    background-color: #2DD4BF;
    border: none;
    border-radius: 12px;
    color: white;
    font-weight: bold;
    min-height: 48px;
}

QPushButton:hover {
    background-color: #14B8A6;
}

QPushButton:pressed {
    background-color: #0F766E;
}
#statCard {
    background:#0D2038;
    border:1px solid #1E3A5F;
    border-radius:18px;

    min-height:80px;
    max-height:100px;
}

#actionCard {
    background:#0D2038;
    border:1px solid #2DD4BF;
    border-radius:18px;

    min-height:45px;
    max-height:55px;
}

#actionCard:hover {
    background:#102845;
}
#pageTitle{
    font-size:34px;
    font-weight:700;
    color:#FFFFFF;
    margin-top:20px;
}

#pageSubtitle{
    font-size:15px;
    color:#CBD5E1;
    margin-bottom:15px;
}
#welcomeCard {
    background:#0D2038;
    border:1px solid #1E3A5F;
    border-radius:18px;
    padding:20px;
}

#welcomeTitle {
    font-size:18px;
    font-weight:700;
    color:white;
}

#welcomeLocation {
    font-size:16px;
    color:#2DD4BF;
    margin-top:10px;
}


#usersCountLabel{
    color:#22d3ee;
    font-size:11px;
    font-weight:600;
}

#welcomeInfo{
    color:#cbd5e1;
    font-size:12px;
    font-weight:600;
}

#loginPage {
    background: #FFFFFF;
    color: #172033;
}

#loginPage #loginFormPanel {
    background: #FFFFFF;
    border: none;
}

#loginPage #loginFormColumn {
    max-width: 420px;
    min-width: 360px;
    background: transparent;
}

#loginPage #loginHeroPanel {
    background: #EAF4FF;
    border: none;
}

#loginPage #loginHeroImage {
    background: transparent;
}

#loginPage #loginTitle {
    color: #0B2F66;
    font-size: 40px;
    font-weight: 1000;
    background: transparent;
}

#loginPage #loginSubtitle {
    color: #0B2F66;
    font-size: 18px;
    font-weight: 900;
    background: transparent;
}

#loginPage #loginFieldLabel {
    color: #172033;
    font-size: 14px;
    font-weight: 800;
    background: transparent;
}

#loginPage QLineEdit#loginInput {
    background: #FFFFFF;
    border: 1px solid #D8E3F2;
    border-radius: 12px;
    color: #172033;
    font-size: 14px;
    min-height: 46px;
    padding: 10px 42px 10px 14px;
}

#loginPage QLineEdit#loginInput:focus {
    border: 1px solid #147BFF;
}

#loginPage #loginForgotLink {
    color: #147BFF;
    font-size: 13px;
    font-weight: 700;
    background: transparent;
}

#loginPage QPushButton#loginPrimaryButton {
    background: #147BFF;
    border: none;
    border-radius: 12px;
    color: #FFFFFF;
    font-size: 15px;
    font-weight: 900;
    min-height: 50px;
}

#loginPage QPushButton#loginPrimaryButton:hover {
    background: #0E6CE0;
}

#loginPage QPushButton#loginPrimaryButton:pressed {
    background: #0757B8;
}

#loginPage QPushButton#loginSecondaryButton {
    background: #FFFFFF;
    border: 1px solid #147BFF;
    border-radius: 12px;
    color: #147BFF;
    font-size: 15px;
    font-weight: 900;
    min-height: 50px;
}

#loginPage QPushButton#loginSecondaryButton:hover {
    background: #EAF4FF;
}

#loginPage #loginSecurityNote {
    color: #6B7A90;
    font-size: 12px;
    font-weight: 700;
    background: transparent;
}

#loginPage #loginDeveloperCredit {
    color: #9AA8BC;
    font-size: 10px;
    font-weight: 600;
    background: transparent;
}