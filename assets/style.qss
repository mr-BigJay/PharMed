QWidget {
    background: #F4F7FC;
    color: #172033;
    font-family: Vazirmatn, Segoe UI, Tahoma;
    font-size: 14px;
}

QLabel {
    background: transparent;
    color: #172033;
}

QLineEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox {
    background: #FFFFFF;
    border: 1px solid #DFE7F3;
    border-radius: 14px;
    color: #172033;
    min-height: 36px;
    padding: 8px 12px;
}

QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
    border: 1px solid #147BFF;
}

#searchCombo {
    padding-left: 12px;
    padding-right: 12px;
}

#searchCombo::drop-down,
#searchCombo::down-arrow {
    width: 0px;
    height: 0px;
    border: none;
    image: none;
}

#plainCombo::drop-down {
    background: transparent;
    border: none;
    subcontrol-origin: padding;
    subcontrol-position: center left;
    width: 20px;
}

#plainCombo::down-arrow {
    image: none;
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #94A3B8;
    margin-left: 4px;
}

QSpinBox::up-button,
QSpinBox::down-button,
QDoubleSpinBox::up-button,
QDoubleSpinBox::down-button {
    width: 0;
    height: 0;
    border: none;
    margin: 0;
    padding: 0;
}

#plainQuantity {
    padding-left: 12px;
    padding-right: 12px;
}

QPushButton {
    background: #147BFF;
    border: none;
    border-radius: 14px;
    color: #FFFFFF;
    font-weight: 800;
    min-height: 42px;
    padding: 6px 16px;
}

QPushButton:hover {
    background: #0E6CE0;
}

QPushButton:pressed {
    background: #0757B8;
}

QGroupBox,
#panelCard,
#heroCard,
#dateCard {
    background: #FFFFFF;
    border: 1px solid #E4ECF7;
    border-radius: 18px;
    margin-top: 10px;
    padding: 14px;
}

QGroupBox::title {
    color: #0B2F66;
    font-weight: 900;
    padding: 0 8px;
}

#compactForm {
    margin-left: auto;
    margin-right: auto;
    max-width: 520px;
    min-width: 360px;
}

#compactForm QLineEdit,
#compactForm QComboBox,
#compactForm QSpinBox,
#compactForm QDoubleSpinBox {
    max-width: 360px;
    min-width: 240px;
}

#compactForm QPushButton {
    max-width: 360px;
    min-width: 240px;
}

QTableWidget {
    background: #FFFFFF;
    border: 1px solid #E4ECF7;
    border-radius: 16px;
    color: #172033;
    gridline-color: #EEF3FA;
    selection-background-color: #DCEBFF;
    selection-color: #0B2F66;
}

QTableWidget::item {
    padding: 8px;
}

QHeaderView::section {
    background: #F7FAFE;
    border: none;
    border-bottom: 1px solid #E4ECF7;
    color: #516070;
    font-weight: 900;
    min-height: 34px;
    padding: 8px;
}

QScrollArea,
#pageScroll,
#pageCanvas,
#appShell {
    background: #F4F7FC;
    border: none;
}

#appSidebar {
    background: #06356D;
    border: none;
}

#brandIcon {
    background: #147BFF;
    border-radius: 26px;
    color: white;
    font-size: 28px;
    font-weight: 900;
    min-height: 52px;
    min-width: 52px;
    qproperty-alignment: AlignCenter;
}

#brandTitle {
    color: #FFFFFF;
    font-size: 17px;
    font-weight: 900;
    line-height: 1.6;
    margin-bottom: 12px;
}

#navButton {
    background: transparent;
    border-radius: 12px;
    color: #E7F0FF;
    font-size: 14px;
    font-weight: 800;
    min-height: 44px;
    padding: 8px 14px;
    text-align: right;
}

#navButton:hover {
    background: #0A4E9B;
}

#navButton[active="true"] {
    background: #147BFF;
    color: #FFFFFF;
}

#sidebarFooter {
    color: #A9C8F7;
    font-size: 11px;
    font-weight: 700;
}

#topBar {
    background: #FFFFFF;
    border-bottom: 1px solid #E4ECF7;
}

#topSearch {
    background: #FFFFFF;
    border: 1px solid #D8E3F2;
    border-radius: 22px;
    min-height: 38px;
    padding: 6px 18px;
}

#topIcon {
    color: #1C4D86;
    font-size: 22px;
    font-weight: 900;
}

#topBadge {
    color: #0B2F66;
    font-weight: 900;
    padding: 5px 8px;
}

#avatar {
    background: #E7F0FF;
    border-radius: 20px;
    color: #147BFF;
    font-size: 24px;
    min-height: 40px;
    min-width: 40px;
    qproperty-alignment: AlignCenter;
}

#topUserName {
    color: #0B2F66;
    font-size: 13px;
    font-weight: 900;
}

#topUserStatus {
    color: #18A957;
    font-size: 11px;
    font-weight: 800;
}

#topUserLocation {
    color: #147BFF;
    font-size: 11px;
    font-weight: 800;
}

#expiryBellButton {
    background: #FFF5E8;
    border: 1px solid #FFE1B5;
    border-radius: 12px;
    color: #0B2F66;
    font-size: 16px;
    font-weight: 900;
    min-height: 42px;
    min-width: 56px;
    padding: 6px 12px;
}

#expiryBellButton:hover {
    background: #FFE1B5;
}

#heroCard {
    min-height: 84px;
}

#heroTitle {
    color: #0B2F66;
    font-size: 23px;
    font-weight: 1000;
}

#heroSubtitle {
    color: #6B7A90;
    font-size: 13px;
    font-weight: 700;
}

#dateCard {
    min-width: 145px;
}

#dateValue {
    color: #0B2F66;
    font-size: 16px;
    font-weight: 900;
}

#metricBlue,
#metricGreen,
#metricPurple,
#metricOrange,
#metricRed,
#metricSky {
    border-radius: 18px;
    padding: 12px;
}

#metricBlue {
    background: #EAF4FF;
    border: 1px solid #C7E0FF;
}

#metricGreen {
    background: #EAFBF4;
    border: 1px solid #BDEED7;
}

#metricPurple {
    background: #F1ECFF;
    border: 1px solid #D8CCFF;
}

#metricOrange {
    background: #FFF5E8;
    border: 1px solid #FFE1B5;
}

#metricRed {
    background: #FFF0F1;
    border: 1px solid #FFD1D5;
}

#metricSky {
    background: #EAF8FF;
    border: 1px solid #BDEAFF;
}

#metricIcon {
    font-size: 34px;
    min-width: 52px;
    qproperty-alignment: AlignCenter;
}

#metricTitle {
    color: #526176;
    font-size: 13px;
    font-weight: 900;
}

#metricValue {
    color: #0B2F66;
    font-size: 28px;
    font-weight: 1000;
}

#metricSubtitle {
    color: #6B7A90;
    font-size: 12px;
    font-weight: 800;
}

#panelTitle {
    color: #0B2F66;
    font-size: 16px;
    font-weight: 1000;
}

#panelInfo,
#summaryRow {
    color: #526176;
    font-size: 13px;
    font-weight: 800;
}

#quickGreen,
#quickRed,
#quickBlue,
#quickOrange,
#quickPurple,
#quickGray {
    border-radius: 16px;
    min-height: 62px;
    font-weight: 900;
}

#quickGreen {
    background: #13C884;
}

#quickRed {
    background: #FF5D6C;
}

#quickBlue {
    background: #147BFF;
}

#quickOrange {
    background: #FF9F2D;
}

#quickPurple {
    background: #8B5CF6;
}

#quickGray {
    background: #64748B;
}

#pageTitle {
    color: #0B2F66;
    font-size: 28px;
    font-weight: 1000;
    margin-top: 8px;
}

#pageSubtitle {
    color: #6B7A90;
    font-size: 14px;
    font-weight: 800;
}

#welcomeTitle {
    color: #0B2F66;
    font-size: 18px;
    font-weight: 1000;
}

#welcomeInfo,
#usersCountLabel {
    color: #526176;
    font-size: 13px;
    font-weight: 800;
}

#actionCard {
    background: #FFFFFF;
    border: 1px solid #E4ECF7;
    border-radius: 18px;
}

#actionCard:hover {
    background: #EAF4FF;
    border: 1px solid #147BFF;
}

#actionCardLabel {
    color: #0B2F66;
    font-weight: 900;
}

#logoutButton {
    background: #EF4444;
}

#logoutButton:hover {
    background: #DC2626;
}

#dangerButton {
    background: #EF4444;
}

#dangerButton:hover {
    background: #DC2626;
}

#sectionButton {
    background: #FFFFFF;
    border: 1px solid #D8E3F2;
    color: #0B2F66;
    min-height: 44px;
}

#sectionButton:hover {
    background: #EAF4FF;
}

#sectionButton[active="true"] {
    background: #147BFF;
    border: 1px solid #147BFF;
    color: #FFFFFF;
}
